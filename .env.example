# ═══════════════════════════════════════════════════════════
# XILEF Backend - Variables de Entorno
# Copiar a .env y completar los valores
# ═══════════════════════════════════════════════════════════

# ── Base de datos ─────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/xilef

# ── Puerto del servidor (opcional, default: 3000) ─────
PORT=3000

# ── Seguridad - Licencias ─────────────────────────────
# IMPORTANTE: Generar valores seguros únicos. Mínimo 32 caracteres.
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LICENSE_SECRET_KEY=cambiar-por-una-clave-segura-min-32-chars
LICENSE_SIGN_SECRET=cambiar-por-otra-clave-segura-min-32-chars

# ── Ruta del archivo de licencia offline (.lic) ─────
# LICENSE_FILE_PATH=./license.lic
